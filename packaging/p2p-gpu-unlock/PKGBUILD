# SPDX-License-Identifier: GPL-2.0-only
# Vendored from Zagitta/gpu-unlock packaging/arch (pinned commit below),
# with two deliberate changes:
#   1. Package names renamed to p2p-gpu-unlock-*. AUR helpers match AUR
#      packages by name; same-named local builds get tracked by paru and
#      offered AUR upgrades. The rename removes that link entirely.
#      conflicts/replaces cover migration from the AUR-named (or pre-rename
#      local) installs in one transaction.
#   2. Source pinned to an exact upstream commit as a tarball with a
#      sha256 check (upstream uses a local git checkout; we do not clone
#      HEAD, so no floating supply chain). NVIDIA inputs are sha256-pinned
#      by the upstream values.
#
# Upgrading gpu-unlock = bump _commit + _tarball_sha256 (+ pkgver if the
# VERSION file moved) in a visible diff in this repo. Nothing else floats.
pkgbase=p2p-gpu-unlock
pkgname=(p2p-gpu-unlock-dkms p2p-gpu-unlock-firmware)
pkgver=2.0.0
pkgrel=1
_nv=610.43.03
_installer=NVIDIA-Linux-x86_64-$_nv-no-compat32.run
_commit=0532473b4b105ed216948ed9c5aaeab0fa5c734f
_tarball_sha256=a8d30dac52fbc0f0720ef81616effa8c08965afd21873c7a7f26f8c8c55642cd
pkgdesc='Pre-driver FP/BF16 issue-rate unlock (gpu-unlock 2.0.0, p2p namespace)'
arch=('x86_64')
url='https://github.com/Zagitta/gpu-unlock'
license=('GPL-2.0-only')
makedepends=('python' 'zstd' 'openssl')
options=('!strip' '!debug')
source=("https://github.com/Zagitta/gpu-unlock/archive/${_commit}.tar.gz"
        "https://download.nvidia.com/XFree86/NVIDIA-kernel-module-source/NVIDIA-kernel-module-source-$_nv.tar.xz"
        "https://download.nvidia.com/XFree86/Linux-x86_64/$_nv/$_installer")
sha256sums=(${_tarball_sha256}
            '7e118923c7a23edc36114d63273a46e3e04e9af98695a42203e7ac2dfe9fc1dc'
            'e084451db730a6df29d3d74f655749c4d236e3c945f7d94b5205e84318fe2f90')
# GitHub codeload tarballs unpack to <repo>-<full-sha>/
_srcdir_name=gpu-unlock-${_commit}

prepare() {
  cd "${_srcdir_name}"
  got=$(cat VERSION)
  [ "$got" = "$pkgver" ] || {
    printf 'VERSION is %s, pkgver is %s (pinned %s)\n' \
      "$got" "$pkgver" "${_commit:0:12}" >&2
    return 1
  }
}

build() {
  cd "${_srcdir_name}"
  python firmware/extract_gsp.py "$(realpath "$srcdir/$_installer")" "$srcdir/assets"
  python firmware/extract_boot_assets.py "$srcdir/NVIDIA-kernel-module-source-$_nv" "$srcdir/assets"
}

package_p2p-gpu-unlock-dkms() {
  arch=('any')
  depends=('dkms' "p2p-gpu-unlock-firmware=$pkgver-$pkgrel")
  backup=('etc/mkinitcpio.conf.d/zz-gpu-unlock.conf')
  conflicts=('gpu-unlock-mkinitcpio' 'gpu-unlock-dkms' 'gpu-unlock-firmware')
  replaces=('gpu-unlock-mkinitcpio' 'gpu-unlock-dkms' 'gpu-unlock-firmware')
  install=p2p-gpu-unlock.install
  cd "${_srcdir_name}"
  make DESTDIR="$pkgdir" install-dkms install-mkinitcpio install-dracut
  make DESTDIR="$pkgdir" PKG=$pkgname install-licenses
}

package_p2p-gpu-unlock-firmware() {
  pkgdesc='Locally generated, pinned NVIDIA 610.43.03 firmware assets for gpu-unlock (p2p namespace)'
  license=('LicenseRef-NVIDIA' 'GPL-2.0-only')
  conflicts=('gpu-unlock-firmware')
  replaces=('gpu-unlock-firmware')
  cd "${_srcdir_name}"
  make DESTDIR="$pkgdir" ASSETS="$srcdir/assets" install-firmware
}
